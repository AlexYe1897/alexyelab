---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter, fade } from 'astro:transitions';

type SchemaType =
  | 'WebSite'
  | 'WebPage'
  | 'AboutPage'
  | 'CollectionPage'
  | 'BlogPosting'
  | 'CreativeWork';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  ogImageAlt?: string;
  schemaType?: SchemaType;
  schemaKeywords?: string[];
  robots?: string;
  pageTone?: 'default' | 'home' | 'about';
  article?: {
    publishedTime: string;
    section?: string;
    tags?: string[];
  };
}

const {
  title,
  description = 'Alex Ye 的个人技术网站，记录人工智能、大语言模型、软件工程与计算机系统相关的项目和文章。',
  ogType = 'website',
  ogImage = '/og-default.png',
  ogImageAlt = 'Alex Ye Lab 个人技术博客',
  schemaType,
  schemaKeywords,
  robots,
  pageTone = 'default',
  article,
} = Astro.props;

const siteName = 'Alex Ye Lab';
const pageTitle = title ? `${title} | ${siteName}` : siteName;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
const siteURL = new URL('/', Astro.site);
const resolvedSchemaType =
  schemaType ?? (ogType === 'article' ? 'BlogPosting' : 'WebPage');
const author = {
  '@type': 'Person',
  name: 'Alex Ye',
  url: new URL('/about/', Astro.site).href,
  sameAs: ['https://github.com/AlexYe1897'],
};
const structuredData = {
  '@context': 'https://schema.org',
  '@type': resolvedSchemaType,
  name: title ?? siteName,
  description,
  url: canonicalURL.href,
  image: {
    '@type': 'ImageObject',
    url: ogImageURL.href,
    width: 1200,
    height: 630,
  },
  inLanguage: 'zh-CN',
  ...(resolvedSchemaType !== 'WebSite' && {
    isPartOf: {
      '@type': 'WebSite',
      name: siteName,
      url: siteURL.href,
    },
  }),
  ...(resolvedSchemaType === 'WebSite' && { author }),
  ...(resolvedSchemaType === 'BlogPosting' && {
    headline: title ?? siteName,
    datePublished: article?.publishedTime,
    articleSection: article?.section,
    keywords: article?.tags?.join(', '),
    author,
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': canonicalURL.href,
    },
  }),
  ...(resolvedSchemaType === 'CreativeWork' && {
    creator: author,
    keywords: schemaKeywords?.join(', '),
  }),
};
const structuredDataJSON = JSON.stringify(structuredData).replace(
  /</g,
  '\\u003c',
);
---

<!doctype html>
<html
  lang="zh-CN"
  data-theme={pageTone === 'home' ? 'dark' : undefined}
  data-theme-lock={pageTone === 'home' ? 'dark' : undefined}
  transition:animate={fade({ duration: '180ms' })}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content={pageTone === 'home' ? '#020806' : '#f7faf9'}
    />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}

    <script is:inline>
      (() => {
        const storageKey = 'alexyelab-theme';
        const applyDocumentTheme = () => {
          const root = document.documentElement;
          const lockedTheme = root.dataset.themeLock;
          let storedTheme = null;

          try {
            storedTheme = window.localStorage.getItem(storageKey);
          } catch {
            // localStorage may be unavailable in privacy-restricted contexts.
          }

          const preferredTheme = window.matchMedia(
            '(prefers-color-scheme: dark)',
          ).matches
            ? 'dark'
            : 'light';
          const theme =
            lockedTheme === 'dark'
              ? 'dark'
              : storedTheme === 'dark' || storedTheme === 'light'
                ? storedTheme
                : preferredTheme;

          root.dataset.theme = theme;
          root.style.colorScheme = theme;

          const themeColor = document.querySelector('meta[name="theme-color"]');
          themeColor?.setAttribute(
            'content',
            theme === 'dark'
              ? lockedTheme === 'dark'
                ? '#020806'
                : '#111416'
              : '#f7faf9',
          );
        };

        if (!window.__alexYeThemeSwapBound) {
          document.addEventListener('astro:after-swap', applyDocumentTheme);
          window.__alexYeThemeSwapBound = true;
        }

        applyDocumentTheme();
      })();
    </script>

    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Alex Ye Lab RSS"
      href="/rss.xml"
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    {
      ogType === 'article' && article && (
        <>
          <meta
            property="article:published_time"
            content={article.publishedTime}
          />
          {article.section && (
            <meta property="article:section" content={article.section} />
          )}
          {article.tags?.map((tag) => (
            <meta property="article:tag" content={tag} />
          ))}
        </>
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link
      rel="preload"
      href="/fonts/google-sans-flex-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/noto-sans-sc-site.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta name="generator" content={Astro.generator} />
    <ClientRouter />

    {
      !robots?.includes('noindex') && (
        <script
          type="application/ld+json"
          is:inline
          set:html={structuredDataJSON}
        />
      )
    }

    <title>{pageTitle}</title>
  </head>

  <body
    class:list={[
      'flex min-h-dvh flex-col text-ink antialiased',
      pageTone === 'default' && 'bg-canvas',
      pageTone === 'home' && 'page-home',
      pageTone === 'about' && 'page-about',
    ]}
  >
    <a class="skip-link" href="#main-content">跳到主要内容</a>

    <Navbar />

    <main id="main-content" tabindex="-1" class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
