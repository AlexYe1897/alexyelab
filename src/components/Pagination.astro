---
const { currentPage, totalPages } = Astro.props;
---

{
  totalPages > 1 && (
    <nav class="mt-12 flex justify-center gap-3">
      {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
        <a
          href={`/blog/page/${page}`}
          class={`
                            px-3 py-1 rounded
                            ${
                              page === currentPage
                                ? 'bg-black text-white'
                                : 'border'
                            }
                        `}
        >
          {page}
        </a>
      ))}
    </nav>
  )
}
