---
interface Props {
  id: string;
  label: string;
  placeholder: string;
  queryParam?: string;
}

const { id, label, placeholder, queryParam = 'q' } = Astro.props;
---

<div
  data-expandable-search
  data-query-param={queryParam}
  data-state="closed"
  class="search-control control-shell flex h-11 min-w-0 items-center overflow-hidden"
>
  <button
    data-search-toggle
    type="button"
    aria-label={`展开${label}`}
    aria-controls={id}
    aria-expanded="false"
    class="relative flex size-11 shrink-0 items-center justify-center transition hover:text-accent focus-visible:outline-none"
  >
    <svg
      data-search-icon
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      class="search-icon size-6"
    >
      <circle cx="10.75" cy="10.75" r="5.75"></circle>
      <path stroke-linecap="round" d="m15 15 4 4"></path>
    </svg>

    <svg
      data-search-close-icon
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      class="search-close-icon absolute size-6"
    >
      <path stroke-linecap="round" d="M6 6l12 12M18 6 6 18"></path>
    </svg>
  </button>

  <div class="search-field min-w-0 flex-1">
    <div class="search-field-inner min-w-0">
      <label class="sr-only" for={id}>{label}</label>
      <input
        id={id}
        type="search"
        placeholder={placeholder}
        autocomplete="off"
        tabindex="-1"
        class="search-input h-10 w-full min-w-0 bg-transparent pr-3 text-sm text-ink placeholder:text-ink-faint focus-visible:outline-none"
      />
    </div>
  </div>
</div>

<style>
  .search-control {
    width: 2.75rem;
    flex: 0 0 2.75rem;
    border-color: transparent;
    background: transparent;
    box-shadow: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    transition:
      width var(--site-motion-base) var(--site-ease-standard),
      flex-basis var(--site-motion-base) var(--site-ease-standard),
      background-color var(--site-motion-fast) var(--site-ease-standard);
  }

  .search-control[data-state='open'] {
    width: auto;
    flex: 1 1 0%;
    background: color-mix(in srgb, var(--site-surface) 68%, transparent);
    -webkit-backdrop-filter: blur(10px) saturate(108%);
    backdrop-filter: blur(10px) saturate(108%);
  }

  .search-control:focus-within {
    border-color: transparent;
    outline: 2px solid color-mix(in srgb, var(--site-focus) 70%, transparent);
    outline-offset: 0;
  }

  .search-field {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateX(-0.25rem);
    transition:
      opacity var(--site-motion-fast) var(--site-ease-standard),
      transform var(--site-motion-base) var(--site-ease-standard),
      visibility 0s linear var(--site-motion-base);
  }

  .search-control[data-state='open'] .search-field {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(0);
    transition-delay: 0s;
  }

  .search-icon,
  .search-close-icon {
    transition:
      opacity var(--site-motion-fast) var(--site-ease-standard),
      transform var(--site-motion-base) var(--site-ease-standard);
  }

  .search-close-icon {
    opacity: 0;
    transform: rotate(-45deg) scale(0.8);
  }

  .search-control[data-state='open'] .search-icon {
    opacity: 0;
    transform: rotate(45deg) scale(0.8);
  }

  .search-control[data-state='open'] .search-close-icon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  @media (min-width: 40rem) {
    .search-control[data-state='open'] {
      width: 12rem;
      flex: 0 0 12rem;
    }
  }

  @media (min-width: 40rem) and (hover: hover) and (pointer: fine) {
    .search-control:hover {
      width: 12rem;
      flex-basis: 12rem;
      border-color: transparent;
      background-color: color-mix(
        in srgb,
        var(--site-accent-soft) 70%,
        transparent
      );
      -webkit-backdrop-filter: blur(10px) saturate(108%);
      backdrop-filter: blur(10px) saturate(108%);
    }

    .search-control:hover .search-field {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateX(0);
      transition-delay: 0s;
    }
  }

  @media (max-width: 39.999rem) {
    .search-control {
      display: contents;
    }

    .search-field {
      display: grid;
      grid-template-rows: 0fr;
      grid-row: 2;
      grid-column: 1 / -1;
      min-height: 0;
      overflow: hidden;
      border-radius: var(--site-radius-control);
      transform: translateY(-0.25rem);
      transition:
        grid-template-rows var(--site-motion-base) var(--site-ease-standard),
        opacity var(--site-motion-fast) var(--site-ease-standard),
        transform var(--site-motion-base) var(--site-ease-standard),
        visibility 0s linear var(--site-motion-base);
    }

    .search-field-inner {
      min-height: 0;
      overflow: hidden;
    }

    .search-input {
      height: 2.75rem;
      padding-inline: 0.875rem;
      border: 1px solid transparent;
      border-radius: var(--site-radius-control);
      background: color-mix(in srgb, var(--site-surface) 68%, transparent);
      -webkit-backdrop-filter: blur(10px) saturate(108%);
      backdrop-filter: blur(10px) saturate(108%);
    }

    .search-field:focus-within .search-input {
      outline: 2px solid color-mix(in srgb, var(--site-focus) 70%, transparent);
      outline-offset: -2px;
    }

    .search-control[data-state='open'] .search-field {
      grid-template-rows: 1fr;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .search-control,
    .search-field,
    .search-icon,
    .search-close-icon {
      transition: none;
    }
  }
</style>

<script>
  let expandableSearchController: AbortController | undefined;

  const initializeExpandableSearch = () => {
    expandableSearchController?.abort();
    expandableSearchController = new AbortController();
    const { signal } = expandableSearchController;

    document
      .querySelectorAll<HTMLElement>('[data-expandable-search]')
      .forEach((control) => {
        const input = control.querySelector<HTMLInputElement>('.search-input');
        const toggle = control.querySelector<HTMLButtonElement>(
          '[data-search-toggle]',
        );
        const field = control.querySelector<HTMLElement>('.search-field');

        if (!input || !toggle) return;

        const label = input.labels?.[0]?.textContent?.trim() || '搜索';
        const queryParam = control.dataset.queryParam || 'q';

        const setOpen = (open: boolean) => {
          if (!open && document.activeElement === input) {
            toggle.focus({ preventScroll: true });
          }
          control.dataset.state = open ? 'open' : 'closed';
          input.tabIndex = open ? 0 : -1;
          field?.setAttribute('aria-hidden', String(!open));
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute(
            'aria-label',
            open ? `关闭${label}` : `展开${label}`,
          );
        };

        const initialQuery = new URL(window.location.href).searchParams.get(
          queryParam,
        );
        if (initialQuery && !input.value) input.value = initialQuery;
        setOpen(Boolean(input.value));

        input.addEventListener('focus', () => setOpen(true), { signal });
        input.addEventListener(
          'input',
          () => {
            if (input.value) setOpen(true);
          },
          { signal },
        );

        toggle.addEventListener(
          'click',
          (event) => {
            const isOpen = control.dataset.state === 'open';

            if (isOpen) {
              if (input.value) {
                input.value = '';
                input.dispatchEvent(new Event('input', { bubbles: true }));
              }
              setOpen(false);
              if (event.detail > 0) toggle.blur();
            } else {
              setOpen(true);
              input.focus({ preventScroll: true });
            }
          },
          { signal },
        );

        input.addEventListener(
          'keydown',
          (event) => {
            if (event.key !== 'Escape') return;

            if (input.value) {
              input.value = '';
              input.dispatchEvent(new Event('input', { bubbles: true }));
            }
            setOpen(false);
            toggle.focus();
          },
          { signal },
        );

        control.addEventListener(
          'focusout',
          () => {
            window.setTimeout(() => {
              if (!control.contains(document.activeElement) && !input.value) {
                setOpen(false);
              }
            });
          },
          { signal },
        );

        document.addEventListener(
          'pointerdown',
          (event) => {
            if (!control.contains(event.target as Node) && !input.value) {
              setOpen(false);
            }
          },
          { signal },
        );
      });
  };

  document.addEventListener('astro:page-load', initializeExpandableSearch);
</script>
