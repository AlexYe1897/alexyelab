---
interface Props {
  id: string;
  label: string;
  placeholder: string;
  queryParam?: string;
}

const { id, label, placeholder, queryParam = 'q' } = Astro.props;
---

<div
  data-expandable-search
  data-query-param={queryParam}
  data-state="closed"
  class="search-control flex h-11 min-w-0 items-center overflow-hidden rounded-lg border bg-white text-gray-600"
>
  <button
    data-search-toggle
    type="button"
    aria-label={`展开${label}`}
    aria-controls={id}
    aria-expanded="false"
    class="relative flex size-11 shrink-0 items-center justify-center transition hover:text-black focus-visible:outline-none"
  >
    <svg
      data-search-icon
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      class="search-icon size-6"
    >
      <circle cx="10.75" cy="10.75" r="5.75"></circle>
      <path stroke-linecap="round" d="m15 15 4 4"></path>
    </svg>

    <svg
      data-search-close-icon
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      class="search-close-icon absolute size-6"
    >
      <path stroke-linecap="round" d="M6 6l12 12M18 6 6 18"></path>
    </svg>
  </button>

  <div class="search-field min-w-0 flex-1">
    <label class="sr-only" for={id}>{label}</label>
    <input
      id={id}
      type="search"
      placeholder={placeholder}
      autocomplete="off"
      class="search-input h-10 w-full min-w-0 bg-transparent pr-3 text-sm text-black placeholder:text-gray-400 focus-visible:outline-none"
    />
  </div>
</div>

<style>
  .search-control {
    width: 2.75rem;
    flex: 0 0 2.75rem;
    transition:
      width 200ms ease,
      flex-basis 200ms ease,
      background-color 150ms ease;
  }

  .search-control[data-state='open'] {
    width: auto;
    flex: 1 1 0%;
  }

  .search-control:focus-within {
    outline: 2px solid #111827;
    outline-offset: 3px;
  }

  .search-field {
    opacity: 0;
    pointer-events: none;
    transform: translateX(-0.25rem);
    transition:
      opacity 150ms ease,
      transform 180ms ease;
  }

  .search-control[data-state='open'] .search-field {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(0);
  }

  .search-icon,
  .search-close-icon {
    transition:
      opacity 150ms ease,
      transform 180ms ease;
  }

  .search-close-icon {
    opacity: 0;
    transform: rotate(-45deg) scale(0.8);
  }

  .search-control[data-state='open'] .search-icon {
    opacity: 0;
    transform: rotate(45deg) scale(0.8);
  }

  .search-control[data-state='open'] .search-close-icon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  @media (min-width: 40rem) {
    .search-control[data-state='open'] {
      width: 12rem;
      flex: 0 0 12rem;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .search-control:hover {
      width: 12rem;
      flex-basis: 12rem;
      background-color: #f9fafb;
    }

    .search-control:hover .search-field {
      opacity: 1;
      pointer-events: auto;
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .search-control,
    .search-field,
    .search-icon,
    .search-close-icon {
      transition: none;
    }
  }
</style>

<script>
  document
    .querySelectorAll<HTMLElement>('[data-expandable-search]')
    .forEach((control) => {
      const input = control.querySelector<HTMLInputElement>('.search-input');
      const toggle = control.querySelector<HTMLButtonElement>('[data-search-toggle]');

      if (!input || !toggle) return;

      const label = input.labels?.[0]?.textContent?.trim() || '搜索';
      const queryParam = control.dataset.queryParam || 'q';

      const setOpen = (open: boolean) => {
        control.dataset.state = open ? 'open' : 'closed';
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? `关闭${label}` : `展开${label}`);
      };

      const initialQuery = new URL(window.location.href).searchParams.get(queryParam);
      if (initialQuery && !input.value) input.value = initialQuery;
      setOpen(Boolean(input.value));

      input.addEventListener('focus', () => setOpen(true));
      input.addEventListener('input', () => {
        if (input.value) setOpen(true);
      });

      toggle.addEventListener('click', (event) => {
        const isOpen = control.dataset.state === 'open';

        if (isOpen) {
          if (input.value) {
            input.value = '';
            input.dispatchEvent(new Event('input', { bubbles: true }));
          }
          setOpen(false);
          if (event.detail > 0) toggle.blur();
        } else {
          setOpen(true);
          input.focus();
        }
      });

      input.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;

        if (input.value) {
          input.value = '';
          input.dispatchEvent(new Event('input', { bubbles: true }));
        }
        setOpen(false);
        toggle.focus();
      });

      control.addEventListener('focusout', () => {
        window.setTimeout(() => {
          if (!control.contains(document.activeElement) && !input.value) {
            setOpen(false);
          }
        });
      });

      document.addEventListener('pointerdown', (event) => {
        if (!control.contains(event.target as Node) && !input.value) {
          setOpen(false);
        }
      });
    });
</script>
