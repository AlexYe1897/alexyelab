---
let seed = 1897;
const random = () => {
  seed = (seed * 9301 + 49297) % 233280;
  return seed / 233280;
};

const stars = Array.from({ length: 118 }, (_, index) => {
  const isBright = index % 8 === 0;

  return {
    x: 2 + random() * 96,
    y: 2 + random() * 62,
    size: isBright ? 2 + random() * 1.25 : 0.85 + random() * 1.25,
    opacity: isBright ? 0.82 + random() * 0.16 : 0.35 + random() * 0.5,
    duration: 5.5 + random() * 5.5,
    delay: -random() * 11,
    pattern: index % 3,
    isBright,
  };
});
---

<div class="home-space" aria-hidden="true">
  <img
    class="home-earth"
    src="/images/home-earth.webp"
    width="1672"
    height="941"
    alt=""
    fetchpriority="high"
    decoding="async"
  />

  <div class="home-stars">
    {
      stars.map((star) => (
        <span
          class:list={[
            'home-star',
            `home-star--pattern-${star.pattern}`,
            { 'home-star--bright': star.isBright },
          ]}
          style={`--star-x:${star.x.toFixed(2)}%;--star-y:${star.y.toFixed(2)}%;--star-size:${star.size.toFixed(2)}px;--star-opacity:${star.opacity.toFixed(2)};--star-dim:${(star.opacity * 0.18).toFixed(2)};--star-soft:${(star.opacity * 0.52).toFixed(2)};--star-duration:${star.duration.toFixed(2)}s;--star-delay:${star.delay.toFixed(2)}s;`}
        />
      ))
    }
  </div>

  <div class="home-space-shade"></div>
</div>

<style>
  .home-space {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: #020806;
    pointer-events: none;
  }

  .home-earth {
    position: absolute;
    bottom: var(--home-earth-y, 0px);
    left: 50%;
    z-index: 1;
    width: max(100%, 70rem);
    max-width: none;
    height: auto;
    opacity: 0.94;
    transform: translate3d(-50%, 0, 0) scale(var(--home-earth-scale, 1));
    transform-origin: center bottom;
  }

  .home-stars {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .home-star {
    position: absolute;
    top: var(--star-y);
    left: var(--star-x);
    width: var(--star-size);
    height: var(--star-size);
    border-radius: 50%;
    background: #dff9ee;
    opacity: var(--star-opacity);
    box-shadow: 0 0 0.35rem rgb(118 224 182 / 28%);
    animation-duration: var(--star-duration);
    animation-timing-function: ease-in-out;
    animation-delay: var(--star-delay);
    animation-iteration-count: infinite;
  }

  .home-star--pattern-0 {
    animation-name: home-star-twinkle-a;
  }

  .home-star--pattern-1 {
    animation-name: home-star-twinkle-b;
  }

  .home-star--pattern-2 {
    animation-name: home-star-twinkle-c;
  }

  .home-star--bright {
    background: #f4fffa;
    box-shadow:
      0 0 0.45rem rgb(129 233 193 / 52%),
      0 0 1rem rgb(67 174 156 / 22%);
  }

  .home-space-shade {
    position: absolute;
    inset: 0;
    z-index: 3;
    background:
      linear-gradient(
        180deg,
        rgb(2 8 6 / 0%) 62%,
        rgb(2 8 6 / 24%) 82%,
        #020806 100%
      ),
      linear-gradient(
        90deg,
        rgb(2 8 6 / 18%),
        transparent 24% 76%,
        rgb(2 8 6 / 18%)
      );
  }

  @keyframes home-star-twinkle-a {
    0%,
    18%,
    100% {
      opacity: var(--star-dim);
      transform: scale(0.48);
    }

    25% {
      opacity: var(--star-opacity);
      transform: scale(1.24);
    }

    31% {
      opacity: var(--star-soft);
      transform: scale(0.78);
    }

    38% {
      opacity: var(--star-opacity);
      transform: scale(1.08);
    }

    49% {
      opacity: var(--star-dim);
      transform: scale(0.52);
    }
  }

  @keyframes home-star-twinkle-b {
    0%,
    36%,
    100% {
      opacity: var(--star-dim);
      transform: scale(0.52);
    }

    45% {
      opacity: var(--star-opacity);
      transform: scale(1.2);
    }

    52% {
      opacity: var(--star-soft);
      transform: scale(0.84);
    }

    61% {
      opacity: var(--star-opacity);
      transform: scale(1.12);
    }

    72% {
      opacity: var(--star-dim);
      transform: scale(0.5);
    }
  }

  @keyframes home-star-twinkle-c {
    0%,
    56%,
    100% {
      opacity: var(--star-dim);
      transform: scale(0.46);
    }

    65% {
      opacity: var(--star-opacity);
      transform: scale(1.26);
    }

    72% {
      opacity: var(--star-soft);
      transform: scale(0.76);
    }

    80% {
      opacity: var(--star-opacity);
      transform: scale(1.08);
    }

    91% {
      opacity: var(--star-dim);
      transform: scale(0.5);
    }
  }

  @media (max-width: 767px) {
    .home-earth {
      top: 0;
      bottom: auto;
      width: 68rem;
      opacity: 0.88;
      -webkit-mask-image: linear-gradient(
        to bottom,
        #000 0%,
        #000 76%,
        rgb(0 0 0 / 82%) 84%,
        transparent 100%
      );
      mask-image: linear-gradient(
        to bottom,
        #000 0%,
        #000 76%,
        rgb(0 0 0 / 82%) 84%,
        transparent 100%
      );
    }

    .home-star:nth-child(4n) {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-earth {
      transform: translate3d(-50%, 0, 0);
    }

    .home-star {
      animation: none;
    }
  }
</style>
