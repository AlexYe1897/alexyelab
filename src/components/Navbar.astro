---
const links = [
  { href: '/', label: '首页' },
  { href: '/blog', label: '博客' },
  { href: '/projects', label: '项目' },
  { href: '/about', label: '关于' },
];

const pathname = Astro.url.pathname;
const isHome = pathname === '/';
const isActive = (href: string) => {
  if (href === '/') return pathname === href;
  if (
    href === '/blog' &&
    (pathname === '/tags' || pathname.startsWith('/tags/'))
  ) {
    return true;
  }

  return pathname === href || pathname.startsWith(`${href}/`);
};
---

<nav
  data-site-nav
  aria-label="主导航"
  class="mx-auto w-full max-w-5xl px-6 py-6"
>
  <div class="flex items-center justify-between">
    <a
      href="/"
      aria-label="Alex Ye Lab 首页"
      class="text-xl weight-display transition hover:text-accent"
    >
      Alex Ye Lab
    </a>

    <div class="flex items-center gap-1.5 md:gap-3">
      <div class="mr-1 hidden items-center gap-6 text-ink-muted md:flex">
        {
          links.map((link) => (
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'location' : undefined}
              class:list={[
                'transition hover:text-accent',
                { 'font-semibold text-accent': isActive(link.href) },
              ]}
            >
              {link.label}
            </a>
          ))
        }
      </div>

      {
        !isHome && (
          <button
            data-theme-toggle
            type="button"
            aria-label="切换到深色模式"
            aria-pressed="false"
            title="切换到深色模式"
            class="icon-control icon-control-ghost theme-toggle relative focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            <svg
              data-theme-icon="moon"
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              class="theme-toggle-icon theme-toggle-icon--moon size-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M20.1 15.2A8.4 8.4 0 0 1 8.8 3.9 8.5 8.5 0 1 0 20.1 15.2Z"
              />
            </svg>

            <svg
              data-theme-icon="sun"
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              class="theme-toggle-icon theme-toggle-icon--sun size-5"
            >
              <circle cx="12" cy="12" r="3.5" />
              <path
                stroke-linecap="round"
                d="M12 2.75v2M12 19.25v2M4.75 4.75l1.4 1.4M17.85 17.85l1.4 1.4M2.75 12h2M19.25 12h2M4.75 19.25l1.4-1.4M17.85 6.15l1.4-1.4"
              />
            </svg>
          </button>
        )
      }

      {
        isHome && (
          <span aria-hidden="true" class="hidden size-11 shrink-0 md:block" />
        )
      }

      <button
        data-menu-button
        type="button"
        aria-label="打开导航菜单"
        aria-controls="mobile-navigation"
        aria-expanded="false"
        class="icon-control icon-control-ghost relative focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent md:hidden"
      >
        <svg
          data-menu-icon
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          class="nav-menu-icon size-6"
        >
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>

        <svg
          data-close-icon
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          class="nav-close-icon absolute size-6"
        >
          <path stroke-linecap="round" d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-navigation"
    data-mobile-menu
    data-state="closed"
    aria-hidden="true"
    inert
    class="mobile-menu md:hidden"
  >
    <div class="min-h-0 overflow-hidden">
      <div class="mt-3 pt-2">
        {
          links.map((link) => (
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'location' : undefined}
              class:list={[
                'block rounded-lg px-3 py-3 text-base text-ink-muted transition hover:bg-accent-soft hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
                {
                  'bg-accent-soft font-semibold text-accent': isActive(
                    link.href,
                  ),
                },
              ]}
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</nav>

<style>
  .mobile-menu {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transform: translateY(-0.25rem);
    visibility: hidden;
    transition:
      grid-template-rows 180ms ease,
      opacity 150ms ease,
      transform 180ms ease,
      visibility 0s linear 180ms;
  }

  .mobile-menu[data-state='open'] {
    grid-template-rows: 1fr;
    opacity: 1;
    transform: translateY(0);
    visibility: visible;
    transition-delay: 0s;
  }

  .nav-menu-icon,
  .nav-close-icon,
  .theme-toggle-icon {
    transition:
      opacity 150ms ease,
      transform 180ms ease;
  }

  .theme-toggle-icon {
    position: absolute;
  }

  .theme-toggle-icon--sun {
    opacity: 0;
    transform: rotate(-35deg) scale(0.72);
  }

  :global(html[data-theme='dark']) .theme-toggle-icon--moon {
    opacity: 0;
    transform: rotate(35deg) scale(0.72);
  }

  :global(html[data-theme='dark']) .theme-toggle-icon--sun {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  .nav-close-icon {
    opacity: 0;
    transform: rotate(-45deg) scale(0.8);
  }

  [data-menu-button][aria-expanded='true'] .nav-menu-icon {
    opacity: 0;
    transform: rotate(45deg) scale(0.8);
  }

  [data-menu-button][aria-expanded='true'] .nav-close-icon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  @media (min-width: 48rem) {
    .mobile-menu {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu,
    .nav-menu-icon,
    .nav-close-icon,
    .theme-toggle-icon {
      transition: none;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const themeStorageKey = 'alexyelab-theme';
  const themeMedia = window.matchMedia('(prefers-color-scheme: dark)');
  let themeTransitionTimer: number | undefined;
  let navbarController: AbortController | undefined;

  const readStoredTheme = () => {
    try {
      const storedTheme = window.localStorage.getItem(themeStorageKey);
      return storedTheme === 'dark' || storedTheme === 'light'
        ? storedTheme
        : null;
    } catch {
      return null;
    }
  };

  const syncThemeControls = (theme: 'light' | 'dark') => {
    document
      .querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')
      .forEach((toggle) => {
        const isDark = theme === 'dark';
        const label = isDark ? '切换到浅色模式' : '切换到深色模式';
        toggle.setAttribute('aria-label', label);
        toggle.setAttribute('title', label);
        toggle.setAttribute('aria-pressed', String(isDark));
      });
  };

  const applyTheme = (
    theme: 'light' | 'dark',
    options: { persist?: boolean; animate?: boolean } = {},
  ) => {
    if (root.dataset.themeLock === 'dark') return;

    if (options.animate) {
      root.classList.add('theme-changing');
      if (themeTransitionTimer !== undefined) {
        window.clearTimeout(themeTransitionTimer);
      }
      themeTransitionTimer = window.setTimeout(() => {
        root.classList.remove('theme-changing');
        themeTransitionTimer = undefined;
      }, 260);
    }

    root.dataset.theme = theme;
    root.style.colorScheme = theme;
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', theme === 'dark' ? '#111416' : '#f7faf9');

    if (options.persist) {
      try {
        window.localStorage.setItem(themeStorageKey, theme);
      } catch {
        // The visual theme still works when storage is unavailable.
      }
    }

    syncThemeControls(theme);
    window.dispatchEvent(
      new CustomEvent('site-theme-change', { detail: { theme } }),
    );
  };

  themeMedia.addEventListener('change', (event) => {
    if (readStoredTheme() || root.dataset.themeLock === 'dark') return;
    applyTheme(event.matches ? 'dark' : 'light');
  });

  const initializeNavbar = () => {
    navbarController?.abort();
    navbarController = new AbortController();
    const { signal } = navbarController;

    const initialTheme = root.dataset.theme === 'dark' ? 'dark' : 'light';
    syncThemeControls(initialTheme);

    document
      .querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')
      .forEach((toggle) => {
        toggle.addEventListener(
          'click',
          () => {
            const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
            const reduceMotion = window.matchMedia(
              '(prefers-reduced-motion: reduce)',
            ).matches;
            applyTheme(nextTheme, { persist: true, animate: !reduceMotion });
          },
          { signal },
        );
      });

    document.querySelectorAll<HTMLElement>('[data-site-nav]').forEach((nav) => {
      const button = nav.querySelector<HTMLButtonElement>('[data-menu-button]');
      const menu = nav.querySelector<HTMLElement>('[data-mobile-menu]');
      if (!button || !menu) return;

      const setOpen = (open: boolean) => {
        button.setAttribute('aria-expanded', String(open));
        button.setAttribute(
          'aria-label',
          open ? '关闭导航菜单' : '打开导航菜单',
        );
        menu.dataset.state = open ? 'open' : 'closed';
        menu.setAttribute('aria-hidden', String(!open));
        menu.toggleAttribute('inert', !open);
      };

      button.addEventListener(
        'click',
        () => {
          setOpen(button.getAttribute('aria-expanded') !== 'true');
        },
        { signal },
      );

      menu.addEventListener(
        'click',
        (event) => {
          if ((event.target as Element).closest('a')) setOpen(false);
        },
        { signal },
      );

      document.addEventListener(
        'keydown',
        (event) => {
          if (
            event.key === 'Escape' &&
            button.getAttribute('aria-expanded') === 'true'
          ) {
            setOpen(false);
            button.focus();
          }
        },
        { signal },
      );

      window.addEventListener(
        'resize',
        () => {
          if (window.matchMedia('(min-width: 768px)').matches) setOpen(false);
        },
        { signal },
      );
    });
  };

  document.addEventListener('astro:page-load', initializeNavbar);
</script>
