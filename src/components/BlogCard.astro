---
const { title, description, date, tags, category, slug, words } = Astro.props;
---

<a href={`/blog/${slug}`} class="block">
  <article
    class="rounded-xl border p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg"
  >
    <h2 class="text-xl font-semibold">
      {title}
    </h2>

    <div class="mt-3 flex gap-2 text-sm text-gray-400">
      <span>{category}</span>

      <span>·</span>

      <span>{date}</span>

      <span>·</span>

      <span>{words} 字</span>
    </div>

    <p class="mt-4 text-gray-600">
      {description}
    </p>

    <div class="mt-6 flex items-center justify-between">
      <div class="flex gap-2">
        {
          tags.map((tag) => (
            <span class="rounded bg-gray-100 px-3 py-1 text-sm">{tag}</span>
          ))
        }
      </div>

      <span class="text-sm font-medium"> Read more → </span>
    </div>
  </article>
</a>
