---
const { title, description, date, tags, category, slug, words } = Astro.props;
---

<a href={`/blog/${slug}`} class="block">
  <article
    class="rounded-xl border p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg"
  >
    <h2 class="text-xl font-semibold">
      {title}
    </h2>

    <div class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-sm text-gray-400">
      <span class="whitespace-nowrap">{category}</span>

      <span aria-hidden="true" class="hidden sm:inline">·</span>

      <span class="whitespace-nowrap">{date}</span>

      <span aria-hidden="true" class="hidden sm:inline">·</span>

      <span class="whitespace-nowrap">{words} 字</span>
    </div>

    <p class="mt-4 text-gray-600">
      {description}
    </p>

    <div class="mt-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div class="flex min-w-0 flex-wrap gap-2">
        {
          tags.map((tag) => (
            <span class="whitespace-nowrap rounded bg-gray-100 px-3 py-1 text-sm">
              {tag}
            </span>
          ))
        }
      </div>

      <span class="self-end whitespace-nowrap text-sm font-medium sm:self-auto">
        阅读全文 →
      </span>
    </div>
  </article>
</a>
