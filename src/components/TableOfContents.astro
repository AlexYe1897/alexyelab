---
interface Props {
  headings: Array<{
    depth: number;
    slug: string;
    text: string;
  }>;
  label?: string;
}

const { headings, label = '文章目录' } = Astro.props;

let sectionIndex = 0;
let subsectionIndex = 0;

const tableOfContents = headings
  .filter((heading) => heading.depth === 2 || heading.depth === 3)
  .map((heading) => {
    if (heading.depth === 2) {
      sectionIndex += 1;
      subsectionIndex = 0;

      return {
        ...heading,
        number: String(sectionIndex).padStart(2, '0'),
      };
    }

    subsectionIndex += 1;

    return {
      ...heading,
      number:
        sectionIndex > 0
          ? `${String(sectionIndex).padStart(2, '0')}.${subsectionIndex}`
          : String(subsectionIndex).padStart(2, '0'),
    };
  });
---

{
  tableOfContents.length > 0 && (
    <nav
      data-table-of-contents
      aria-label={label}
      class="detail-toc surface-card p-4"
    >
      <h2 class="mb-3 weight-heading">目录</h2>

      <ul class="space-y-2 text-sm">
        {tableOfContents.map((heading) => (
          <li class={heading.depth === 3 ? 'ml-4' : undefined}>
            <a
              data-toc-link
              href={`#${heading.slug}`}
              class="toc-link relative grid grid-cols-[2rem_minmax(0,1fr)] items-start py-0.5 pl-2 text-ink-muted transition hover:text-accent"
            >
              <span
                aria-hidden="true"
                class="toc-number font-mono text-xs leading-5 text-ink-faint"
              >
                {heading.number}
              </span>
              <span class="break-words leading-5">{heading.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .toc-link::before {
    position: absolute;
    top: 0.125rem;
    bottom: 0.125rem;
    left: 0;
    width: 2px;
    border-radius: 9999px;
    background: var(--site-accent);
    content: '';
    opacity: 0;
    transform: scaleY(0.5);
    transition:
      opacity 150ms ease,
      transform 180ms ease;
  }

  .toc-link[data-active] {
    color: var(--site-accent);
    font-weight: 600;
  }

  .toc-link[data-active]::before {
    opacity: 1;
    transform: scaleY(1);
  }

  .toc-link[data-active] .toc-number {
    color: var(--site-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-link::before {
      transition: none;
    }
  }
</style>

<script>
  let tableOfContentsController: AbortController | undefined;
  let tableOfContentsFrames: number[] = [];

  const initializeTableOfContents = () => {
    tableOfContentsController?.abort();
    tableOfContentsFrames.forEach((frame) =>
      window.cancelAnimationFrame(frame),
    );
    tableOfContentsFrames = [];
    tableOfContentsController = new AbortController();
    const { signal } = tableOfContentsController;

    document
      .querySelectorAll<HTMLElement>('[data-table-of-contents]')
      .forEach((tableOfContents) => {
        const links = Array.from(
          tableOfContents.querySelectorAll<HTMLAnchorElement>(
            '[data-toc-link]',
          ),
        );

        const entries = links
          .map((link) => {
            const hash = link.getAttribute('href')?.slice(1);
            if (!hash) return undefined;

            let headingId = hash;
            try {
              headingId = decodeURIComponent(hash);
            } catch {
              // Keep the original hash if it is already decoded.
            }

            const heading = document.getElementById(headingId);
            return heading ? { link, heading } : undefined;
          })
          .filter((entry) => entry !== undefined);

        if (entries.length === 0) return;

        const setActiveLink = (activeLink: HTMLAnchorElement) => {
          for (const link of links) {
            const isActive = link === activeLink;
            link.toggleAttribute('data-active', isActive);

            if (isActive) {
              link.setAttribute('aria-current', 'location');
            } else {
              link.removeAttribute('aria-current');
            }
          }
        };

        const updateActiveLink = () => {
          const readingLine = Math.min(window.innerHeight * 0.3, 160);
          let activeEntry = entries[0];

          for (const entry of entries) {
            if (entry.heading.getBoundingClientRect().top <= readingLine) {
              activeEntry = entry;
            } else {
              break;
            }
          }

          setActiveLink(activeEntry.link);
        };

        let scheduledFrame: number | undefined;
        const scheduleUpdate = () => {
          if (scheduledFrame !== undefined) return;

          scheduledFrame = window.requestAnimationFrame(() => {
            updateActiveLink();
            scheduledFrame = undefined;
          });
        };

        for (const entry of entries) {
          entry.link.addEventListener(
            'click',
            () => setActiveLink(entry.link),
            { signal },
          );
        }

        window.addEventListener('scroll', scheduleUpdate, {
          passive: true,
          signal,
        });
        window.addEventListener('resize', scheduleUpdate, { signal });
        scheduleUpdate();

        if (scheduledFrame !== undefined) {
          tableOfContentsFrames.push(scheduledFrame);
        }
      });
  };

  document.addEventListener('astro:page-load', initializeTableOfContents);
</script>
