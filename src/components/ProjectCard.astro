---
interface Props {
  slug: string;
  title: string;
  description: string;
  tags: string[];
  headingLevel?: 'h2' | 'h3';
}

const { slug, title, description, tags, headingLevel = 'h3' } = Astro.props;

const visibleTags = tags.slice(0, 3);
const Heading = headingLevel;
---

<a href={`/projects/${slug}`} class="block h-full">
  <article class="interactive-card flex h-full flex-col p-5 sm:p-6">
    <Heading class="text-xl weight-display">
      {title}
    </Heading>

    <p class="mt-3 text-sm leading-6 text-ink-muted">
      {description}
    </p>

    <div class="mt-auto flex flex-wrap gap-2 pt-5">
      {visibleTags.map((tag) => <span class="tag-chip">{tag}</span>)}
    </div>
  </article>
</a>
