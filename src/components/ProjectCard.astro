---
interface Props {
  slug: string;
  title: string;
  description: string;
  tags: string[];
  headingLevel?: 'h2' | 'h3';
  variant?: 'default' | 'home';
}

const {
  slug,
  title,
  description,
  tags,
  headingLevel = 'h3',
  variant = 'default',
} = Astro.props;

const visibleTags = tags.slice(0, 3);
const Heading = headingLevel;
const isHome = variant === 'home';
---

<a href={`/projects/${slug}`} class="block h-full">
  <article
    class:list={[
      'interactive-card flex h-full flex-col',
      isHome ? 'home-content-card p-4 sm:p-5' : 'collection-card p-5 sm:p-6',
    ]}
  >
    <Heading class:list={[isHome ? 'text-lg' : 'text-xl', 'weight-display']}>
      {title}
    </Heading>

    <p class="mt-3 line-clamp-2 text-sm leading-6 text-ink-muted">
      {description}
    </p>

    <div
      class:list={[
        'mt-auto flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between',
        isHome ? 'pt-4' : 'pt-5',
      ]}
    >
      <div class="flex min-w-0 flex-wrap gap-2">
        {visibleTags.map((tag) => <span class="tag-chip">{tag}</span>)}
      </div>

      <span
        class="self-end whitespace-nowrap text-sm font-medium text-accent sm:self-auto"
      >
        查看项目
      </span>
    </div>
  </article>
</a>
