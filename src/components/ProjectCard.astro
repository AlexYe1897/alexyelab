---
import type { CollectionEntry } from 'astro:content';

type ProjectStatus = CollectionEntry<'projects'>['data']['status'];

interface Props {
  slug: string;
  title: string;
  description: string;
  tags: string[];
  status: ProjectStatus;
  headingLevel?: 'h2' | 'h3';
  variant?: 'default' | 'home';
}

const {
  slug,
  title,
  description,
  tags,
  status,
  headingLevel = 'h3',
  variant = 'default',
} = Astro.props;

const visibleTags = tags.slice(0, 3);
const Heading = headingLevel;
const isHome = variant === 'home';
const statusLabels: Record<ProjectStatus, string> = {
  planned: '计划中',
  'in-progress': '进行中',
  completed: '已完成',
};
---

<a href={`/projects/${slug}`} class="block h-full">
  <article
    class:list={[
      'interactive-card flex h-full flex-col',
      isHome ? 'home-content-card p-4 sm:p-5' : 'collection-card p-5 sm:p-6',
    ]}
  >
    <div class="flex flex-wrap items-start justify-between gap-x-3 gap-y-2">
      <Heading
        class:list={[
          isHome ? 'text-lg' : 'text-xl',
          'min-w-0 flex-1 weight-display',
        ]}
      >
        {title}
      </Heading>
      <span class="status-chip project-card-status shrink-0">
        {statusLabels[status]}
      </span>
    </div>

    <p class="mt-3 line-clamp-2 text-sm leading-6 text-ink-muted">
      {description}
    </p>

    <div
      class:list={[
        'mt-auto',
        isHome
          ? 'flex flex-col gap-3 pt-4 sm:flex-row sm:items-end sm:justify-between'
          : 'pt-5',
      ]}
    >
      <div class="flex min-w-0 flex-wrap gap-2">
        {visibleTags.map((tag) => <span class="tag-chip">{tag}</span>)}
      </div>

      {
        isHome && (
          <span class="self-end whitespace-nowrap text-sm font-medium text-accent sm:self-auto">
            查看项目
          </span>
        )
      }
    </div>
  </article>
</a>

<style>
  .project-card-status {
    min-height: 1.5rem;
    padding: 0.125rem 0.5rem;
    font-size: 0.75rem;
    white-space: nowrap;
  }
</style>
