---
interface Props {
  slug: string;
  title: string;
  description: string;
  tags: string[];
}

const { slug, title, description, tags } = Astro.props;

const visibleTags = tags.slice(0, 3);
---

<a href={`/projects/${slug}`} class="block h-full">
  <article
    class="flex h-full flex-col rounded-xl border p-6 transition hover:shadow-lg"
  >
    <h3 class="text-xl font-bold">
      {title}
    </h3>

    <p class="mt-3 text-sm leading-6 text-gray-600">
      {description}
    </p>

    <div class="mt-auto flex flex-wrap gap-2 pt-5">
      {
        visibleTags.map((tag) => (
          <span class="rounded-full bg-gray-100 px-3 py-1 text-sm">{tag}</span>
        ))
      }
    </div>
  </article>
</a>
