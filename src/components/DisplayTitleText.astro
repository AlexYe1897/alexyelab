---
interface Props {
  text: string;
}

const { text } = Astro.props;
const titleParts = text
  .split(/([A-Za-z0-9][A-Za-z0-9\s.+#/_-]*)/g)
  .filter(Boolean);
---

{
  titleParts.map((part) =>
    /^[A-Za-z0-9]/.test(part) ? (
      <span class="weight-display-latin">{part}</span>
    ) : (
      part
    ),
  )
}
