---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import TableOfContents from '../../components/TableOfContents.astro';
import CodeBlockEnhancer from '../../components/CodeBlockEnhancer.astro';
import { getReadingStats } from '../../utils/reading';
import { toTagSlug } from '../../utils/tags';

export async function getStaticPaths() {
  const posts = (
    await getCollection('blog', ({ data }) => !data.draft)
  ).sort((a, b) => {
    const dateDifference =
      new Date(a.data.pubDate).getTime() - new Date(b.data.pubDate).getTime();

    return dateDifference || a.id.localeCompare(b.id);
  });

  return posts.map((post, index) => ({
    params: {
      slug: post.id,
    },

    props: {
      post,
      previousPost:
        index > 0
          ? {
              id: posts[index - 1].id,
              title: posts[index - 1].data.title,
            }
          : undefined,
      nextPost:
        index < posts.length - 1
          ? {
              id: posts[index + 1].id,
              title: posts[index + 1].data.title,
            }
          : undefined,
    },
  }));
}

const { post, previousPost, nextPost } = Astro.props;

const { Content, headings } = await render(post);

const hasTableOfContents = headings.some(
  (heading) => heading.depth === 2 || heading.depth === 3,
);

const { wordCount, readingTime } = getReadingStats(post.body);
---

<Layout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  article={{
    publishedTime: `${post.data.pubDate}T00:00:00.000Z`,
    section: post.data.category,
    tags: post.data.tags,
  }}
>
  <div class="mx-auto max-w-6xl px-6 py-12">
    <a href="/blog" class="text-sm text-gray-500 hover:text-black transition">
      ← 返回博客
    </a>

    <article class="mt-8">
      <header class="mb-8">
        <h1 class="text-4xl font-bold tracking-tight">
          {post.data.title}
        </h1>

        <div class="mt-6 flex gap-3 text-sm text-gray-400">
          <span>
            {post.data.category}
          </span>

          <span> · </span>

          <span>
            {post.data.pubDate}
          </span>

          <span> · </span>

          <span>
            {wordCount} 字
          </span>

          <span> · </span>

          <span>
            预计阅读 {readingTime} 分钟
          </span>
        </div>

        <div class="mt-4 flex gap-2">
          {
            post.data.tags.map((tag) => (
              <a
                href={`/tags/${encodeURIComponent(toTagSlug(tag))}`}
                class="rounded-full bg-gray-100 px-3 py-1 text-sm"
              >
                {tag}
              </a>
            ))
          }
        </div>
      </header>

      <div
        class:list={[
          hasTableOfContents &&
            'lg:grid lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-12',
        ]}
      >
        <div class="min-w-0">
          <div class="prose prose-lg max-w-none">
            <Content />
          </div>

          <CodeBlockEnhancer />

          {
            (previousPost || nextPost) && (
              <nav
                aria-label="文章导航"
                class="mt-12 grid gap-4 border-t pt-8 sm:grid-cols-2"
              >
                {previousPost && (
                  <a
                    href={`/blog/${previousPost.id}`}
                    class="rounded-xl border p-5 transition hover:shadow-lg"
                  >
                    <span class="text-sm text-gray-500">← 上一篇</span>
                    <span class="mt-2 block font-semibold">
                      {previousPost.title}
                    </span>
                  </a>
                )}

                {nextPost && (
                  <a
                    href={`/blog/${nextPost.id}`}
                    class:list={[
                      'rounded-xl border p-5 text-right transition hover:shadow-lg',
                      !previousPost && 'sm:col-start-2',
                    ]}
                  >
                    <span class="text-sm text-gray-500">下一篇 →</span>
                    <span class="mt-2 block font-semibold">
                      {nextPost.title}
                    </span>
                  </a>
                )}
              </nav>
            )
          }
        </div>

        {
          hasTableOfContents && (
            <aside class="hidden lg:block">
              <div class="sticky top-8">
                <TableOfContents headings={headings} />
              </div>
            </aside>
          )
        }
      </div>
    </article>
  </div>
</Layout>
