---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { toTagSlug } from '../../utils/tags';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const tagMap = new Map<string, { name: string; count: number }>();

for (const post of posts) {
  const seenTags = new Set<string>();

  for (const tag of post.data.tags) {
    const slug = toTagSlug(tag);
    if (seenTags.has(slug)) continue;

    seenTags.add(slug);
    const existingTag = tagMap.get(slug);

    if (existingTag) {
      existingTag.count += 1;
    } else {
      tagMap.set(slug, { name: tag, count: 1 });
    }
  }
}

const tags = Array.from(tagMap, ([slug, tag]) => ({ slug, ...tag })).sort(
  (a, b) =>
    b.count - a.count ||
    a.name.localeCompare(b.name, 'zh-CN', { sensitivity: 'base' }),
);
---

<Layout
  title="标签"
  description="浏览 Alex Ye Lab 技术文章使用的全部标签。"
  schemaType="CollectionPage"
>
  <section class="collection-page mx-auto max-w-5xl px-6 pt-10 pb-24 sm:pt-12">
    <a href="/blog" class="collection-back-link">
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        class="size-4"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="m15 18-6-6 6-6"
        ></path>
      </svg>
      <span>返回博客</span>
    </a>

    <header class="mt-6 max-w-2xl">
      <h1 class="text-4xl weight-display tracking-tight sm:text-5xl">标签</h1>
      <p class="collection-count mt-4 text-sm">共 {tags.length} 个标签</p>
    </header>

    {
      tags.length > 0 ? (
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {tags.map((tag) => (
            <a
              href={`/tags/${encodeURIComponent(tag.slug)}`}
              class="tag-directory-card interactive-card collection-card group flex items-center justify-between gap-4 p-5"
            >
              <span class="flex min-w-0 items-center gap-3">
                <span class="tag-directory-icon flex size-9 shrink-0 items-center justify-center">
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    class="size-5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M4.75 5.75v5.1c0 .53.21 1.04.59 1.41l6.4 6.4a2 2 0 0 0 2.83 0l4.09-4.09a2 2 0 0 0 0-2.83l-6.4-6.4a2 2 0 0 0-1.41-.59h-5.1a1 1 0 0 0-1 1Z"
                    ></path>
                    <circle cx="9" cy="9" r="1.25"></circle>
                  </svg>
                </span>
                <span class="min-w-0 break-words weight-subheading">
                  {tag.name}
                </span>
              </span>
              <span class="tag-directory-count shrink-0 whitespace-nowrap text-sm">
                {tag.count} 篇文章
              </span>
            </a>
          ))}
        </div>
      ) : (
        <p class="collection-empty surface-card mt-8 px-5 py-6 text-ink-muted">
          暂时还没有可浏览的标签。
        </p>
      )
    }
  </section>
</Layout>
