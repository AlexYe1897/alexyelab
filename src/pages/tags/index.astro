---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { toTagSlug } from '../../utils/tags';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const tagMap = new Map<string, { name: string; count: number }>();

for (const post of posts) {
  const seenTags = new Set<string>();

  for (const tag of post.data.tags) {
    const slug = toTagSlug(tag);
    if (seenTags.has(slug)) continue;

    seenTags.add(slug);
    const existingTag = tagMap.get(slug);

    if (existingTag) {
      existingTag.count += 1;
    } else {
      tagMap.set(slug, { name: tag, count: 1 });
    }
  }
}

const tags = Array.from(tagMap, ([slug, tag]) => ({ slug, ...tag })).sort(
  (a, b) =>
    b.count - a.count ||
    a.name.localeCompare(b.name, 'zh-CN', { sensitivity: 'base' }),
);
---

<Layout
  title="标签"
  description="浏览 Alex Ye Lab 技术文章使用的全部标签。"
  schemaType="CollectionPage"
>
  <section class="mx-auto max-w-5xl px-6 pt-10 pb-24 sm:pt-12">
    <a href="/blog" class="text-sm text-ink-muted transition hover:text-accent">
      ← 返回博客
    </a>

    <header class="mt-6 max-w-2xl">
      <h1 class="text-4xl weight-display tracking-tight sm:text-5xl">标签</h1>
      <p class="mt-4 text-sm text-ink-muted">共 {tags.length} 个标签</p>
    </header>

    {
      tags.length > 0 ? (
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {tags.map((tag) => (
            <a
              href={`/tags/${encodeURIComponent(tag.slug)}`}
              class="interactive-card flex items-center justify-between gap-4 p-5"
            >
              <span class="min-w-0 break-words font-semibold">{tag.name}</span>
              <span class="shrink-0 text-sm text-ink-muted">
                {tag.count} 篇文章
              </span>
            </a>
          ))}
        </div>
      ) : (
        <p class="mt-8 text-ink-muted">暂时还没有可浏览的标签。</p>
      )
    }
  </section>
</Layout>
