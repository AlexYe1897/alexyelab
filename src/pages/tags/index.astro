---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { toTagSlug } from '../../utils/tags';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const tagMap = new Map<string, { name: string; count: number }>();

for (const post of posts) {
  const seenTags = new Set<string>();

  for (const tag of post.data.tags) {
    const slug = toTagSlug(tag);
    if (seenTags.has(slug)) continue;

    seenTags.add(slug);
    const existingTag = tagMap.get(slug);

    if (existingTag) {
      existingTag.count += 1;
    } else {
      tagMap.set(slug, { name: tag, count: 1 });
    }
  }
}

const tags = Array.from(tagMap, ([slug, tag]) => ({ slug, ...tag })).sort(
  (a, b) =>
    b.count - a.count ||
    a.name.localeCompare(b.name, 'zh-CN', { sensitivity: 'base' }),
);
---

<Layout
  title="标签"
  description="浏览 Alex Ye Lab 技术文章使用的全部标签。"
  schemaType="CollectionPage"
>
  <section class="mx-auto max-w-5xl px-6 pt-12 pb-24 sm:pt-16">
    <a href="/blog" class="text-sm text-gray-500 transition hover:text-black">
      ← 返回博客
    </a>

    <header class="mt-8 max-w-2xl">
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">标签</h1>
      <p class="mt-4 leading-7 text-gray-600">
        按标签浏览博客中的技术文章与学习记录。
      </p>
    </header>

    {
      tags.length > 0 ? (
        <div class="mt-10 grid gap-4 sm:grid-cols-2">
          {tags.map((tag) => (
            <a
              href={`/tags/${encodeURIComponent(tag.slug)}`}
              class="flex items-center justify-between gap-4 rounded-xl border p-5 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md"
            >
              <span class="min-w-0 break-words font-semibold">{tag.name}</span>
              <span class="shrink-0 text-sm text-gray-500">
                {tag.count} 篇文章
              </span>
            </a>
          ))}
        </div>
      ) : (
        <p class="mt-10 text-gray-500">暂时还没有可浏览的标签。</p>
      )
    }
  </section>
</Layout>
