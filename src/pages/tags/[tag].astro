---
import { getCollection } from 'astro:content';
import BlogCard from '../../components/BlogCard.astro';
import Layout from '../../layouts/Layout.astro';
import { getReadingStats } from '../../utils/reading';
import { toTagSlug } from '../../utils/tags';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const postsByTag = new Map<string, { name: string; posts: typeof posts }>();

  for (const post of posts) {
    for (const tag of post.data.tags) {
      const slug = toTagSlug(tag);
      const tagGroup = postsByTag.get(slug);

      if (tagGroup) {
        tagGroup.posts.push(post);
      } else {
        postsByTag.set(slug, { name: tag, posts: [post] });
      }
    }
  }

  return Array.from(postsByTag, ([slug, tagGroup]) => ({
    params: { tag: slug },
    props: tagGroup,
  }));
}

const { name: tag, posts } = Astro.props;

const postsWithInfo = posts
  .map((post) => ({
    ...post,
    words: getReadingStats(post.body).wordCount,
  }))
  .sort(
    (a, b) =>
      new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime(),
  );
---

<Layout
  title={`与 ${tag} 相关的文章`}
  description={`浏览 Alex Ye Lab 中与 ${tag} 相关的技术文章。`}
  schemaType="CollectionPage"
>
  <section class="mx-auto max-w-5xl px-6 pt-10 pb-24 sm:pt-12">
    <a href="/blog" class="text-sm text-ink-muted transition hover:text-accent">
      ← 返回博客
    </a>

    <div class="mt-6">
      <h1 class="text-4xl weight-display tracking-tight sm:text-5xl">
        与 {tag} 相关的文章
      </h1>

      <p class="mt-4 text-sm text-ink-muted">
        共 {postsWithInfo.length} 篇文章
      </p>
    </div>

    <div class="mt-8 grid gap-6">
      {
        postsWithInfo.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            date={post.data.pubDate}
            tags={post.data.tags}
            category={post.data.category}
            slug={post.id}
            words={post.words}
          />
        ))
      }
    </div>
  </section>
</Layout>
