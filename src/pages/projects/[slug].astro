---
import { getCollection, render } from 'astro:content';
import TableOfContents from '../../components/TableOfContents.astro';
import CodeBlockEnhancer from '../../components/CodeBlockEnhancer.astro';
import DisplayTitleText from '../../components/DisplayTitleText.astro';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);

  return projects.map((project) => ({
    params: {
      slug: project.id,
    },
    props: {
      project,
    },
  }));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);

const hasTableOfContents = headings.some(
  (heading) => heading.depth === 2 || heading.depth === 3,
);

const statusLabels = {
  planned: '计划中',
  'in-progress': '进行中',
  completed: '已完成',
};
---

<Layout
  title={project.data.title}
  description={project.data.description}
  schemaType="CreativeWork"
  schemaKeywords={project.data.tags}
>
  <div class="detail-page mx-auto max-w-6xl px-6 pt-8 pb-12 sm:pt-10 sm:pb-16">
    <article>
      <div
        class:list={[
          hasTableOfContents &&
            'lg:grid lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-12',
        ]}
      >
        <div class="article-paper detail-paper min-w-0 p-6 sm:p-8">
          <header class="detail-header detail-article-header">
            <a
              href="/projects"
              class="detail-back-link"
              aria-label="返回项目列表"
            >
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                class="size-4"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="m15 18-6-6 6-6"
                ></path>
              </svg>
              <span>项目</span>
            </a>

            <div class="mt-6 flex flex-wrap items-center gap-3">
              <h1 class="text-4xl weight-display tracking-tight">
                <DisplayTitleText text={project.data.title} />
              </h1>

              <span class="status-chip">
                {statusLabels[project.data.status]}
              </span>
            </div>

            <p class="mt-5 max-w-3xl text-lg leading-8 text-ink-muted">
              {project.data.description}
            </p>

            <div class="detail-tags mt-4 flex flex-wrap gap-2">
              {
                project.data.tags.map((tag) => (
                  <span class="tag-chip">{tag}</span>
                ))
              }
            </div>

            {
              (project.data.website || project.data.repository) && (
                <div class="mt-5 flex flex-wrap gap-3">
                  {project.data.website && (
                    <a
                      href={project.data.website}
                      target="_blank"
                      rel="noreferrer"
                      class="button-primary"
                    >
                      访问项目
                    </a>
                  )}

                  {project.data.repository && (
                    <a
                      href={project.data.repository}
                      target="_blank"
                      rel="noreferrer"
                      class="button-secondary"
                    >
                      查看源码
                    </a>
                  )}
                </div>
              )
            }
          </header>

          <div class="article-prose prose prose-lg max-w-none">
            <Content />
          </div>

          <CodeBlockEnhancer />
        </div>

        {
          hasTableOfContents && (
            <aside class="detail-toc-column hidden lg:block">
              <div class="sticky top-8">
                <TableOfContents headings={headings} label="项目目录" />
              </div>
            </aside>
          )
        }
      </div>
    </article>
  </div>
</Layout>
