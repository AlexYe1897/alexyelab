---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import HomeBackground from '../components/HomeBackground.astro';
import BlogPreview from '../components/BlogPreview.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
---

<Layout
  description="Alex Ye 的个人技术网站，分享人工智能、大语言模型、软件工程与计算机系统相关的项目和文章。"
  schemaType="WebSite"
  pageTone="home"
>
  <div class="home-page">
    <div class="home-landing" data-home-landing>
      <HomeBackground />
      <Hero />

      <section id="latest" class="home-latest" aria-label="最新内容">
        <div class="home-latest-grid grid gap-5 md:grid-cols-2">
          <BlogPreview />

          <ProjectPreview />
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .home-page {
    background: #020806;
  }

  .home-landing {
    position: relative;
    min-height: max(calc(100svh - 5rem), 50rem);
    overflow: hidden;
  }

  .home-latest {
    position: absolute;
    right: 1.5rem;
    bottom: 2rem;
    left: 1.5rem;
    z-index: 6;
    scroll-margin-top: 5rem;
  }

  .home-latest-grid {
    width: min(100%, 64rem);
    margin-inline: auto;
  }

  @media (max-width: 767px) {
    .home-landing {
      min-height: 75rem;
    }

    .home-latest {
      bottom: 2.5rem;
    }
  }
</style>
