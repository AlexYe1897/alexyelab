---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="页面未找到"
  description="抱歉，你访问的页面不存在或已被移动。"
>
  <section
    class="mx-auto flex min-h-[60vh] max-w-5xl items-center px-6 py-16 sm:py-20"
  >
    <div class="max-w-xl">
      <p class="text-sm font-medium text-gray-500">404</p>

      <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
        页面未找到
      </h1>

      <p class="mt-5 text-lg leading-8 text-gray-600">
        抱歉，你访问的页面不存在、已被移动，或地址输入有误。
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href="/"
          class="rounded-lg bg-black px-5 py-3 text-sm font-medium text-white transition hover:bg-gray-800"
        >
          返回首页
        </a>

        <a
          href="/blog"
          class="px-2 py-3 text-sm font-medium text-gray-600 transition hover:text-black"
        >
          查看博客 →
        </a>
      </div>
    </div>
  </section>
</Layout>
